<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Legacy styles.xml - Now using Material Design 3 themes.xml
        These styles are kept for backward compatibility with Capacitor.
        Main theming is in themes.xml following Android best practices.
    -->

    <!-- Base application theme - Delegates to Material Design 3 -->
    <style name="AppTheme" parent="Theme.PocketTeller">
        <!-- Material Design 3 theme with PocketTeller brand colors -->
    </style>

    <!-- No Action Bar theme for web content -->
    <style name="AppTheme.NoActionBar" parent="Theme.PocketTeller">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>

    <!-- Splash Screen theme -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.PocketTeller.Splash">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>